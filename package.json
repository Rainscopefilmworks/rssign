{
  "name": "rssign",
  "version": "1.0.0",
  "description": "A self-hosted, Rainscope-branded open/closed sign for an office tablet — with automatic business hours and Discord remote control.",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "register-commands": "tsx src/register-commands.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rainscopefilmworks/rssign.git"
  },
  "keywords": [
    "rainscope",
    "kiosk",
    "discord",
    "open-sign"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Rainscopefilmworks/rssign/issues"
  },
  "homepage": "https://github.com/Rainscopefilmworks/rssign#readme",
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "node-cron": "^4.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
